<?xml version="1.0" encoding="utf-8"?>
<!--
  Android has refused cleartext traffic by default since API 28, and the Güvən
  API is served over plain http — the main API on port 8008, the 1C bridge
  behind `Baza` on 8005, both on this one host. Rather than switching
  cleartext back on app-wide with `usesCleartextTraffic`, this permits it for
  that host and leaves every other connection TLS-only.

  Delete this file, and the `android:networkSecurityConfig` attribute in the
  manifest, once the backend has a certificate.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">212.64.211.194</domain>
    </domain-config>
</network-security-config>
